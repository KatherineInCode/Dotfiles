#!/usr/bin/env bash
# park — park the current worktree

set -euo pipefail

SCRIPT_NAME="park"
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
# shellcheck source=../includes/logging.bash
source "${SCRIPT_DIR}/../includes/logging.bash"
# shellcheck source=../includes/worktree-helpers.bash
source "${SCRIPT_DIR}/../includes/worktree-helpers.bash"

usage() {
    cat <<'EOF'
Usage: park [-h]

Must be run from a ~/Developer/ios/<letter> directory.
Checks out <letter>-parked, rebases it onto the latest origin/main, then
closes the current tmux window.

Options:
  -h, --help    Show this help message
EOF
}

main() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage
        exit 0
    fi

    local dir
    dir="$(pwd)"
    local folder
    folder="$(basename "$dir")"

    [[ "$(dirname "$dir")" == "${DEVELOPER}/ios" ]] \
        || fatal "not in a greek-letter iOS worktree (current dir: $dir)"

    local letter="$folder"
    local parked_branch="${letter}-parked"

    git -C "$dir" rev-parse --verify "$parked_branch" &>/dev/null \
        || fatal "branch '$parked_branch' not found"

    if [[ -n "$(git -C "$dir" status --porcelain)" ]]; then
        fatal "uncommitted or untracked changes in ${folder} — commit, stash, or remove first"
    fi

    info "checking out ${parked_branch}..."
    git -C "$dir" checkout "$parked_branch"

    fetch_and_rebase_onto_main "$dir" "$parked_branch"

    info "${letter} parked — closing window"

    [[ -n "${TMUX:-}" ]] && tmux kill-window
}

main "$@"
