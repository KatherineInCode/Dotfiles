#!/usr/bin/env bash
# park — park the current worktree

set -euo pipefail

SCRIPT_NAME="park"
SCRIPT_DIR="$(dirname "$(realpath "$0")")"
# shellcheck source=../includes/logging.bash
source "${SCRIPT_DIR}/../includes/logging.bash"
# shellcheck source=../includes/worktree-helpers.bash
source "${SCRIPT_DIR}/../includes/worktree-helpers.bash"

usage() {
    cat <<'EOF'
Usage: park [-h]

Must be run from a ~/Developer/ios/<letter> directory.
Checks out <letter>-parked, rebases it onto the latest origin/main, removes
the worktree's build/ and export/ directories, then closes the current tmux
window.

Options:
  -h, --help    Show this help message
EOF
}

# Removes the worktree's regenerable build artifact directories: build/, which
# holds Xcode DerivedData (build products, module caches, and SPM checkouts),
# and export/, which holds the .xcresult bundles Scripts/build.sh writes.
# Reports the space reclaimed for each. Skips a directory silently when it is
# absent, and refuses to act when git does not consider it ignored — in that
# case it may hold tracked or otherwise unexpected content.
#
# Args:
#   $1 - dir: path to the worktree whose build artifacts should be removed.
remove_build_artifacts() {
    local dir="$1"
    local name

    for name in build export; do
        local target="${dir}/${name}"

        if [[ ! -d "$target" ]]; then
            debug "no ${name} directory at ${target}"
            continue
        fi

        if ! git -C "$dir" check-ignore -q "$name"; then
            warn "${name}/ is not gitignored in ${dir} — leaving it in place"
            continue
        fi

        local size="unknown size"
        size="$(du -sh "$target" 2>/dev/null | awk '{print $1}')" || size="unknown size"

        info "removing ${name} directory (${size})..."
        rm -rf "$target"
    done
}

main() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage
        exit 0
    fi

    local dir
    dir="$(pwd)"
    local folder
    folder="$(basename "$dir")"

    [[ "$(dirname "$dir")" == "${DEVELOPER}/ios" ]] \
        || fatal "not in a greek-letter iOS worktree (current dir: $dir)"

    local letter="$folder"
    local parked_branch="${letter}-parked"

    git -C "$dir" rev-parse --verify "$parked_branch" &>/dev/null \
        || fatal "branch '$parked_branch' not found"

    if [[ -n "$(git -C "$dir" status --porcelain)" ]]; then
        fatal "uncommitted or untracked changes in ${folder} — commit, stash, or remove first"
    fi

    info "checking out ${parked_branch}..."
    git -C "$dir" checkout "$parked_branch"

    fetch_and_rebase_onto_main "$dir" "$parked_branch"

    remove_build_artifacts "$dir"

    info "${letter} parked — closing window"

    [[ -n "${TMUX:-}" ]] && tmux kill-window
}

main "$@"
